        }
      },
      "paymentservice": {
        "Destinations": {
          "paymentservice": { "Address": "http://localhost:5003/" }
        }
      },
      "notificationservice": {
        "Destinations": {
          "notificationservice": { "Address": "http://localhost:5004/" }
        }
      },
      "orderdetailsservice": {
        "Destinations": {
          "orderdetailsservice": { "Address": "http://localhost:5005/" }
        }
      }
    }
  }
}
